# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# TELEGRAM BOT SYSTEM CONFIGURATION
# ==========================================

# BOT_TOKEN: The private API token generated by Telegram @BotFather
BOT_TOKEN="1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# BOT_USERNAME: The username of your Telegram Bot (without @ prefix)
BOT_USERNAME="HanimeScraperBot"

# TMDB_API_KEY: Optional API key for Movie Database metadata synchronization
TMDB_API_KEY="your_tmdb_api_key_here"
TMDB_API="your_tmdb_api_key_here"

# SECRET_KEY: Security salt for web operations and link hashes
SECRET_KEY="change_me_to_a_secure_long_secret_hash_value"

# DATABASE_PATH: Relative or absolute path where the SQLite storage file will reside
DATABASE_PATH="tgbot.db"

# LINK_BASE_URL: Base URL used for building short links. 
# Defaults to your bot redirect starting string if empty.
LINK_BASE_URL=""

# ADMIN_USER_IDS: Comma-separated list of Telegram User IDs that have full Admin control
ADMIN_USER_IDS="987654321,11223344"

# PLAYWRIGHT_TIMEOUT: Maximum timeout in milliseconds for Playwright browser tasks
PLAYWRIGHT_TIMEOUT=30000

# DEFAULT_CREDITS: Starting credits allocated to newly registered users
DEFAULT_CREDITS=50

# STARS_PER_PREMIUM_DAY: Rate of Telegram Stars required per premium day
STARS_PER_PREMIUM_DAY=10

# MTProto Configuration (For uploads up to 2GB)
API_ID=""
API_HASH=""

# MongoDB Configuration
MONGODB_URI=""

# Main Bot Owner / Admin ID
OWNER_ID=""

